# Selin AI 2.0 (Суверенная российская экосистема)
# Скопируй в .env и заполни значения

# Обязательные (Россия / Контур РФ)
MAX_BOT_TOKEN=your_max_bot_token_here
JWT_SECRET=your_secure_random_string_min_32_chars

# Суверенные ИИ-ядра (Россия и Китай/Alibaba)
# Опционально: Cloud.ru (Сбер) для облачного инференса в РФ
CLOUDRU_API_KEY=
CLOUDRU_MODEL=meta-llama/Llama-3-70B-Instruct

# Суверенный поиск в рунете через Яндекс.XML API (безопасно и подконтрольно РФ)
YANDEX_FOLDER_ID=
YANDEX_API_KEY=

# Автономная локальная модель на ВМ (по умолчанию)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com
EDGE_TTS_VOICE=ru-RU-DmitryNeural
TTS_VOICE=ru-RU-DmitryNeural
VOICE_DEFAULT=male
BTN_MODE=text
REDIS_URL=redis://localhost:6379

# Платежные системы (ЮKassa и СБП)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
YOOKASSA_SECRET_KEY=
SBP_PHONE=+7 (999) 000-00-00
OWNER_CHAT_ID=

# Навигация (OSRM)
OSRM_URL=https://router.project-osrm.org

# Безопасность и CORS
ALLOWED_ORIGINS=http://localhost:3000

# Базы данных
DB_TYPE=sqlite
DATABASE_URL=postgresql://user:password@localhost:5432/selin_db

# Firebase (опционально, для синхронизации)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Настройки инцидентов / отладки
IMAGE_EDIT=0
STRESS_FIX=0
